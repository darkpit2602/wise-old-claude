{
  "name": "wise-old-claude-mcp",
  "version": "0.14.0",
  "description": "MCP server exposing your OSRS character snapshot and the OSRS Wiki to Claude",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "sync-contract": "node scripts/sync-contract.mjs",
    "prebundle": "npm run -s sync-contract",
    "bundle": "node scripts/bundle.mjs write",
    "prebundle:check": "npm run -s sync-contract",
    "bundle:check": "node scripts/bundle.mjs check"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "seek-bzip": "^2.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
